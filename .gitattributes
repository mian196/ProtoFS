# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.toml text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.db binary
