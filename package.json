{
  "name": "protofs-workspace",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --prefix frontend tauri dev",
    "start": "npx --prefix frontend tauri dev",
    "build": "npm --prefix frontend run build && cargo build --release",
    "build:installer": "npx --prefix frontend tauri build",
    "build:portable": "npm --prefix frontend run build && cargo build --release -p protofs-tauri",
    "build:cli": "cargo build --release -p protofs-cli",
    "tauri": "node frontend/node_modules/@tauri-apps/cli/tauri.js",
    "android:build": "cd crates/protofs-tauri/gen/android && ./gradlew assembleArm64Release assembleArmRelease assembleUniversalRelease",
    "android:build:debug": "cd crates/protofs-tauri/gen/android && ./gradlew assembleArm64Debug assembleArmDebug assembleUniversalDebug",
    "android:init": "node scripts/init-android.js",
    "version:check": "node scripts/bump-version.js",
    "version:bump": "node scripts/bump-version.js",
    "test": "cargo test --workspace && npm --prefix frontend run lint"
  }
}
